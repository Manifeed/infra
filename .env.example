# PostgreSQL
POSTGRES_ADMIN_DATABASE=postgres
CONTENT_POSTGRES_DB=manifeed_content
IDENTITY_POSTGRES_DB=manifeed_identity
WORKERS_POSTGRES_DB=manifeed_workers
POSTGRES_USER=manifeed
POSTGRES_PASSWORD=manifeed

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=article_embeddings
QDRANT_API_KEY=

# Embedding Service
EMBEDDING_SERVICE_URL=http://host.docker.internal:8000
EMBEDDING_SERVICE_API_KEY=change-me
EMBEDDING_SERVICE_TIMEOUT_SECONDS=300
EMBEDDING_REDIS_QUEUE=embedding:source_embedding
EMBEDDING_SOURCE_EMBEDDING_BATCH_SIZE=128
SOURCE_EMBEDDING_DIMENSIONS=1024
SOURCE_SEARCH_RECENCY_HALFLIFE_DAYS=14

# Edge and local TLS
TRAEFIK_NETWORK_NAME=traefik_proxy
TRAEFIK_DEV_HOST=localhost
TRAEFIK_DEV_DASHBOARD_HOST=traefik.localhost
TRAEFIK_DEV_CERT_DAYS=825

# Public HTTP surface
CORS_ORIGINS=https://localhost,http://localhost,http://localhost:3000,http://localhost:8080
PUBLIC_BASE_URL=https://localhost
PUBLIC_API_ALLOWED_HOSTS=public_api,manifeed_public_api

# RSS Worker
RSS_WORKER_GITHUB_REPOSITORY=Manifeed/workers

# Local repository mounts and build contexts
PUBLIC_API_REPO_PATH=../public_api
SHARED_BACKEND_REPO_PATH=../shared_backend
ADMIN_SERVICE_REPO_PATH=../admin_service
AUTH_SERVICE_REPO_PATH=../auth_service
CONTENT_SERVICE_REPO_PATH=../content_service
INDEXER_SERVICE_REPO_PATH=../indexer_service
USER_SERVICE_REPO_PATH=../user_service
WORKER_SERVICE_REPO_PATH=../worker_service
FRONTEND_REPO_PATH=../frontend
WORKERS_REPO_PATH=../workers
RSS_FEEDS_HOST_PATH=../rss_feeds

# Container-to-container URLs
BACKEND_INTERNAL_URL_ADMIN=http://public_api:8000
AUTH_SERVICE_URL=http://auth_service:8000
AUTH_SERVICE_TIMEOUT_SECONDS=5
USER_SERVICE_URL=http://user_service:8000
USER_SERVICE_TIMEOUT_SECONDS=5
ADMIN_SERVICE_URL=http://admin_service:8000
ADMIN_SERVICE_TIMEOUT_SECONDS=10
CONTENT_SERVICE_URL=http://content_service:8000
CONTENT_SERVICE_TIMEOUT_SECONDS=10
WORKER_SERVICE_URL=http://worker_service:8000
WORKER_SERVICE_TIMEOUT_SECONDS=10

# Runtime wiring
RSS_FEEDS_REPOSITORY_PATH=/rss_feeds
INTERNAL_SERVICE_TOKEN=change-me-in-production-with-at-least-32-chars
AUTH_SERVICE_DB_POOL_SIZE=5
AUTH_SERVICE_DB_MAX_OVERFLOW=10
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
